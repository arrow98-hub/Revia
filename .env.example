# ── Supabase (Project Settings → API) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sesión (genera con: openssl rand -base64 48) ──────────────
SESSION_COOKIE_SECRET=

# ── Resend (códigos de inicio de sesión) ──────────────────────
RESEND_API_KEY=
LOGIN_CODE_FROM=Revia <acceso@tudominio.com>

# ── Notificaciones push (genera con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# ── Cron del aviso diario (genera con: openssl rand -hex 32) ──
CRON_SECRET=
